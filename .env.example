# =============================================================================
# TIM REPUESTOS · variables de entorno
# Copiar a .env.local (desarrollo) y cargar en Vercel → Settings → Environment Variables.
# NUNCA subir .env.local al repositorio.
# =============================================================================

# URL pública del sitio (sin barra final). En Vercel: el dominio de producción.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Clave pública ("publishable" o "anon"). Es pública por diseño: la seguridad la dan RLS y las RPC.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta ("secret" o "service_role"). SOLO SERVIDOR: sin prefijo NEXT_PUBLIC_.
# Se usa únicamente para el rate limiting de login/registro y el script de promoción de admin.
SUPABASE_SERVICE_ROLE_KEY=
